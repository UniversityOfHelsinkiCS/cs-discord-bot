{
  "name": "cs-discord-bot",
  "version": "0.1.0",
  "description": "Discord bot for UH CS Dept.",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production node src/index.js",
    "dev": "cross-env NODE_ENV=development nodemon src/index.js",
    "jest": "cross-env NODE_ENV=test jest --coverage --verbose --runInBand --detectOpenHandles",
    "test": "cross-env NODE_ENV=test jest --coverage --runInBand",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/__tests__/setup/env.js"
    ],
    "moduleNameMapper": {
      "^@sentry/node$": "<rootDir>/__tests__/mocks/@sentry/node.js"
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "__tests__",
      "/src/db/hookInit.js",
      "/src/discordBot/services/command.js",
      "/src/discordBot/services/logger.js",
      "src/discordBot/services/confirm.js",
      "src/discordBot/commands/faculty/create_poll.js",
      "src/discordBot/commands/admin/update_database.js",
      "src/discordBot/commands/admin/restore_server_from_database.js",
      "src/discordBot/commands/admin/server_status.js",
      "src/discordBot/commands/admin/list_courses.js"
    ],
    "testRegex": "./__tests__/jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UniversityOfHelsinkiCS/cs-discord-bot"
  },
  "author": "Jami Kousa, Kalle \"Sendouc\", Lari Löfman, Antti Kantola, Timo Reijonen, Teemu Närhi, Okko Kuisma, Eemeli Saari, Mikko Pelkonen, Miika Koskela",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/UniversityOfHelsinkiCS/cs-discord-bot"
  },
  "homepage": "https://github.com/UniversityOfHelsinkiCS/cs-discord-bot#readme",
  "dependencies": {
    "@discordjs/rest": "2.6.3",
    "@sentry/node": "10.75.0",
    "axios": "1.20.0",
    "connect-flash": "0.1.1",
    "connect-session-sequelize": "8.0.6",
    "discord-api-types": "0.38.55",
    "discord.js": "14.27.0",
    "dotenv": "18.0.0",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "passport": "0.7.0",
    "passport-discord": "0.1.4",
    "pg": "8.23.0",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.8",
    "umzug": "3.8.3",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "jest": "30.5.2",
    "nodemon": "3.1.14",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "sequelize-cli": "6.6.5",
    "sequelize-mock": "0.10.2",
    "supertest": "7.2.2"
  }
}
